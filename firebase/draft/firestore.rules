rules_version = '2';
// PROTOTYPE ONLY — not connected to any Firebase deployment configuration.
// Assumed model (see schema.md): accounts/{uid}; organisations/{orgId};
// organisation memberships/{uid}, entitlements/{moduleId},
// modules/{moduleId}/records/{recordId}, auditEvents/{eventId}, invitations/{id}.
// All fields are service-owned. No direct browser reads or writes in this phase.
// Authenticated reads will require a separately reviewed emulator-tested policy.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
